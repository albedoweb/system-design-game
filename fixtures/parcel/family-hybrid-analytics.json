{
  "schemaVersion": 1,
  "levelId": "parcel-pulse",
  "name": "Family: operational SQL plus columnar analytics",
  "nodes": [
    {
      "id": "client-1",
      "kind": "client",
      "label": "Client",
      "position": {
        "x": 0,
        "y": 160
      },
      "config": {
        "size": "small"
      }
    },
    {
      "id": "app-1",
      "kind": "app",
      "label": "Application",
      "position": {
        "x": 420,
        "y": 160
      },
      "config": {
        "size": "medium"
      }
    },
    {
      "id": "sql-1",
      "kind": "sql",
      "label": "SQL primary",
      "position": {
        "x": 920,
        "y": 160
      },
      "config": {
        "size": "large",
        "storageTb": 24,
        "index": "parcel",
        "partition": "month",
        "latestStatus": true,
        "rollups": false,
        "retentionYears": 5,
        "compression": "zstd"
      }
    },
    {
      "id": "columnar-1",
      "kind": "columnar",
      "label": "Columnar analytics",
      "position": {
        "x": 920,
        "y": 420
      },
      "config": {
        "size": "medium",
        "storageTb": 2,
        "partition": "month",
        "rollups": false,
        "retentionYears": 1,
        "batchIntervalMs": 1000,
        "compression": "zstd",
        "columnProjection": true
      }
    }
  ],
  "edges": [
    {
      "id": "edge-traffic",
      "source": "client-1",
      "target": "app-1",
      "operation": "traffic"
    },
    {
      "id": "edge-ingest",
      "source": "app-1",
      "target": "sql-1",
      "operation": "ingest"
    },
    {
      "id": "edge-status",
      "source": "app-1",
      "target": "sql-1",
      "operation": "status"
    },
    {
      "id": "edge-history",
      "source": "app-1",
      "target": "sql-1",
      "operation": "history"
    },
    {
      "id": "edge-report",
      "source": "app-1",
      "target": "columnar-1",
      "operation": "report"
    },
    {
      "id": "edge-replicate",
      "source": "sql-1",
      "target": "columnar-1",
      "operation": "replicate"
    }
  ]
}
